{
  "name": "fetch-rig",
  "version": "0.1.0",
  "description": "A zero-dependency, universal HTTP client built on the Fetch API. Works in browsers, Node 20+, Deno, Bun, and Cloudflare Workers.",
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "middleware",
    "retry",
    "sse",
    "stream"
  ],
  "license": "MIT",
  "author": {
    "name": "junhyungL",
    "url": "https://github.com/junhyungL"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junhyungL/fetch-rig.git"
  },
  "homepage": "https://github.com/junhyungL/fetch-rig#readme",
  "bugs": {
    "url": "https://github.com/junhyungL/fetch-rig/issues"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  }
}
